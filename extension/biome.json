{
  "$schema": "https://biomejs.dev/schemas/2.6.8/schema.json",
  "files": {
    "includes": [
      "src/**",
      "vite.config.ts",
      "vite.overlay.config.ts",
      "vitest.config.ts",
      "playwright.config.ts"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "semicolons": "always"
    }
  },
  "linter": {
    "enabled": true,
    "domains": {},
    "rules": {}
  }
}
