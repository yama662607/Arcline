{
  "name": "arcline-extension",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "biome check",
    "format": "biome format --write",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:ui": "vitest --ui",
    "patch:sw-manifest": "node scripts/patch-sw-manifest.mjs",
    "test:e2e": "vite build --mode test && pnpm patch:sw-manifest && PLAYWRIGHT_HEADLESS=1 npx playwright test -c playwright/playwright.config.ts",
    "test:e2e:headless": "vite build --mode test && pnpm patch:sw-manifest && playwright test -c playwright/playwright.config.ts",
    "test:performance": "lhci autorun",
    "test:reports": "../scripts/generate-test-reports.sh --all",
    "quality-check": "../scripts/quality-check.sh",
    "quality-check:strict": "../scripts/quality-check.sh --strict",
    "quality-check:full": "../scripts/quality-check.sh --all",
    "setup-hooks": "../scripts/setup-hooks.js",
    "check": "pnpm lint && pnpm format && pnpm typecheck",
    "check:strict": "pnpm lint && pnpm format && pnpm typecheck && pnpm test:coverage"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-toast": "^1.2.15",
    "@tanstack/react-query": "^5.90.12",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "framer-motion": "^12.23.26",
    "fuse.js": "^7.1.0",
    "lucide-react": "^0.561.0",
    "motion": "^12.23.26",
    "pathe": "^2.0.3",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "tailwind-merge": "^3.4.0",
    "zustand": "^5.0.9"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.9",
    "@crxjs/vite-plugin": "^2.3.0",
    "@hookform/resolvers": "^5.2.2",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.57.0",
    "@tailwindcss/postcss": "^4.1.18",
    "@tanstack/react-virtual": "^3.13.13",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.1",
    "@testing-library/user-event": "^14.6.1",
    "@types/chrome": "^0.1.32",
    "@types/node": "^25.0.2",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react-swc": "^4.2.2",
    "@vitest/coverage-v8": "^4.0.15",
    "@vitest/ui": "^4.0.15",
    "audit-ci": "^7.1.0",
    "autoprefixer": "^10.4.23",
    "esbuild": "^0.27.1",
    "happy-dom": "^20.0.11",
    "postcss": "^8.5.6",
    "react-hook-form": "^7.68.0",
    "tailwindcss": "^4.1.18",
    "typescript": "^5.9.3",
    "vite": "^7.3.0",
    "vitest": "^4.0.15",
    "zod": "^4.2.0"
  }
}
