{
  "name": "arcline-monorepo",
  "private": true,
  "packageManager": "pnpm@9.0.0",
  "scripts": {
    "dev": "turbo run dev",
    "build": "pnpm --filter arcline-extension run build",
    "preview": "pnpm --filter arcline-extension run preview",
    "test": "pnpm --filter arcline-extension run test",
    "test:e2e": "pnpm --filter arcline-extension run test:e2e",
    "lint": "pnpm --filter arcline-extension run lint",
    "format": "pnpm --filter arcline-extension run format",
    "typecheck": "pnpm --filter arcline-extension run typecheck",
    "check": "pnpm --filter arcline-extension run check"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.4",
    "@arcline/openspec-cli": "workspace:*",
    "typescript": "^5.9.3",
    "turbo": "^2.6.0"
  }
}