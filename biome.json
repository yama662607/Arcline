{
  "$schema": "https://biomejs.dev/schemas/1.8.3/schema.json",
  "files": {
    "include": ["apps/**/*.{ts,tsx,js,jsx}", "docs/**/*.md", "openspec/**/*.md"],
    "ignore": ["**/dist/**", "**/node_modules/**", "**/legacy/**"]
  },
  "formatter": {
    "enabled": true,
    "lineWidth": 100
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true
    }
  }
}
