{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "files": {
    "includes": [
      "extension/**/*.{ts,tsx,js,jsx}",
      "docs/**/*.md",
      "openspec/**/*.md",
      "!**/dist/**",
      "!**/node_modules/**",
      "!**/legacy/**"
    ]
  },
  "formatter": {
    "enabled": true,
    "lineWidth": 100
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true
    }
  }
}