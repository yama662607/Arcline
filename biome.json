{
  "$schema": "https://biomejs.dev/schemas/2.3.4/schema.json",
  "files": {
    "includes": [
      "apps/**/*.{ts,tsx,js,jsx}",
      "docs/**/*.md",
      "openspec/**/*.md",
      "!**/dist/**",
      "!**/node_modules/**",
      "!**/legacy/**"
    ]
  },
  "formatter": {
    "enabled": true,
    "lineWidth": 100
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true
    }
  }
}